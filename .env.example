# Variables de entorno para docker-compose.prod.yml
# Copiar este archivo como .env y completar los valores.
# NUNCA subir .env al repo.

# Contraseña de PostgreSQL. Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=cambiame

# URL del panel web (Vercel o dominio propio). Debe coincidir con CORS.
FRONTEND_URL=https://panel.ezmatch.app

# Clave compartida con n8n (header X-Bot-Key). Mínimo 32 caracteres. Generar con: openssl rand -hex 32
BOT_API_KEY=cambiame-por-una-clave-larga-y-aleatoria

# Club demo "Pádel Demo" para probar el bot (true/false) y el id del inbox de Chatwoot al que se vincula.
SEED_DEMO_CLUB=true
SEED_CHATWOOT_INBOX_ID=
